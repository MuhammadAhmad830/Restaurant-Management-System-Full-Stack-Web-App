<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="ResturantManagmentSystemApp.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        #components-reconnect-modal {
            display: none !important;
        }
    </style>

    <script>
        (function () {
            var user = sessionStorage.getItem("userName");
            var path = window.location.pathname;
            if (!user && path !== "/login") {
                window.location.href = "/login";
            }
        })();
    </script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />

    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        Blazor.start({
            reconnectionOptions: {
                maxRetries: 100,
                retryIntervalMilliseconds: 3000,
            }
        });
    </script>

    <script>
        window.printOrderReceiptById = function (elementId) {
            var el = document.getElementById(elementId);
            if (!el) { alert('Not found!'); return; }
            localStorage.setItem('receiptContent', el.innerHTML);
            window.open('/print.html', '_blank', 'width=850,height=700');
        };
    </script>
</body>
</html>