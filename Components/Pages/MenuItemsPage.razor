@page "/menuitems"
@using Microsoft.EntityFrameworkCore
@using ResturantManagmentSystemApp.Model
@using ResturantManagmentSystemApp
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Menu Items</PageTitle>

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary fw-bold">Manage Menu Items</h2>
        @* Add Button ab Modal open karega *@
        <button class="btn btn-success fw-bold" @onclick="ShowAddModal">+ Add New Item</button>
    </div>

    @if (MenuItems == null)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p>Loading items...</p>
        </div>
    }
    else
    {
        <div class="table-responsive bg-white p-3 shadow-sm rounded">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in MenuItems)
                    {
                        <tr>
                            <td><div class="border rounded" style="width:50px; height:50px; background:#f8f9fa;"></div></td>
                            <td class="align-middle">@item.Name</td>
                            <td class="align-middle">@item.Category?.Name</td>
                            <td class="align-middle">Rs. @item.Price</td>
                            <td class="align-middle">
                                <span class="badge @(item.IsAvailable ? "bg-success" : "bg-danger")">
                                    @(item.IsAvailable ? "Available" : "Sold Out")
                                </span>
                            </td>
                            <td class="align-middle">
                                <button class="btn btn-sm btn-info text-white me-1" @onclick="() => EditItem(item)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteItem(item.Id)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@* Simple Modal for Add/Edit *@
@if (showModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(currentItem.Id == 0 ? "Add New Item" : "Edit Item")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label>Item Name</label>
                        <input @bind="currentItem.Name" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Price</label>
                        <input @bind="currentItem.Price" type="number" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label>Category</label>
                        <select @bind="currentItem.CategoryId" class="form-control">
                            <option value="0">Select Category</option>
                            @foreach (var cat in Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary" @onclick="SaveItem">Save Changes</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<MenuItem>? MenuItems;
    private List<Category> Categories = new();
    private MenuItem currentItem = new();
    private bool showModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        MenuItems = await Db.MenuItems.Include(m => m.Category).ToListAsync();
        Categories = await Db.Categories.ToListAsync();
    }

    private void ShowAddModal()
    {
        currentItem = new MenuItem { IsAvailable = true };
        showModal = true;
    }

    private void EditItem(MenuItem item)
    {
        currentItem = item;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task SaveItem()
    {
        if (currentItem.Id == 0)
            Db.MenuItems.Add(currentItem);
        else
            Db.MenuItems.Update(currentItem);

        await Db.SaveChangesAsync();
        showModal = false;
        await LoadData();
    }

    private async Task DeleteItem(int id)
    {
        bool confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this item?");
        if (confirmed)
        {
            var item = await Db.MenuItems.FindAsync(id);
            if (item != null)
            {
                Db.MenuItems.Remove(item);
                await Db.SaveChangesAsync();
                await LoadData();
            }
        }
    }
}