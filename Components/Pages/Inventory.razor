@page "/inventory"
@using Microsoft.EntityFrameworkCore
@using ResturantManagmentSystemApp.Model
@inject AppDbContext Db
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-dark">Inventory & Stock</h2>
        <button class="btn btn-primary shadow-sm" @onclick="OpenModal">
            <i class="bi bi-plus-lg"></i> Add New Item
        </button>
    </div>

    @* Low Stock Alerts - Sirf tab dikhayen jab list khali na ho *@
    @if (inventoryList != null && inventoryList.Any(i => i.Quantity <= i.MinStockLevel))
    {
        <div class="row mb-4">
            @foreach (var item in inventoryList.Where(i => i.Quantity <= i.MinStockLevel))
            {
                <div class="col-md-4 mb-2">
                    <div class="alert alert-danger shadow-sm border-start border-5 border-danger mb-0">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-exclamation-octagon-fill fs-4 me-3 text-danger"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Restock Required!</h6>
                                <small>@item.ItemName is only @item.Quantity @item.Unit left.</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @* Inventory Table *@
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="bg-light text-dark fw-bold">
                        <tr>
                            <th class="ps-4">Item Name</th>
                            <th>Current Stock</th>
                            <th>Unit</th>
                            <th>Min Level</th>
                            <th>Price/Unit</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (inventoryList == null || !inventoryList.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                                    No inventory items found. Add your first item!
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in inventoryList)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@item.ItemName</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.Unit</td>
                                    <td>@item.MinStockLevel</td>
                                    <td>Rs. @item.UnitPrice.ToString("N0")</td>
                                    <td>
                                        @if (item.Quantity <= item.MinStockLevel)
                                        {
                                            <span class="badge bg-danger text-white">Critical</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success text-white">Healthy</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <button class="btn btn-sm btn-outline-danger border-0" @onclick="() => DeleteItem(item.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@* Add Item Modal *@
@if (showAddModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.6); backdrop-filter: blur(2px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title fw-bold">Add New Stock Item</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold small">Item Name</label>
                        <input type="text" class="form-control" @bind="newItem.ItemName" placeholder="e.g. Chicken" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label fw-bold small">Quantity</label>
                            <input type="number" class="form-control" @bind="newItem.Quantity" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">Unit</label>
                            <select class="form-select" @bind="newItem.Unit">
                                <option value="kg">kg</option>
                                <option value="Litre">Litre</option>
                                <option value="Packet">Packet</option>
                                <option value="Piece">Piece</option>
                            </select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-6">
                            <label class="form-label fw-bold small">Min Stock Level</label>
                            <input type="number" class="form-control" @bind="newItem.MinStockLevel" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-bold small">Cost Price</label>
                            <input type="number" class="form-control" @bind="newItem.UnitPrice" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-light" @onclick="CloseModal">Cancel</button>
                    <button class="btn btn-primary px-4" @onclick="SaveItem">Save Inventory</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<InventoryItem> inventoryList = new();
    private InventoryItem newItem = new();
    private bool showAddModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadInventory();
    }

    private async Task LoadInventory()
    {
        try
        {
            inventoryList = await Db.InventoryItems.OrderBy(i => i.ItemName).ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading inventory: {ex.Message}");
            inventoryList = new List<InventoryItem>();
        }
    }

    private void OpenModal() => showAddModal = true;
    private void CloseModal() => showAddModal = false;

    private async Task SaveItem()
    {
        if (string.IsNullOrWhiteSpace(newItem.ItemName)) return;

        try
        {
            Db.InventoryItems.Add(newItem);
            await Db.SaveChangesAsync();

            newItem = new InventoryItem();
            showAddModal = false;
            await LoadInventory();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving: {ex.Message}");
        }
    }

    private async Task DeleteItem(int id)
    {
        try
        {
            var item = await Db.InventoryItems.FindAsync(id);
            if (item != null)
            {
                Db.InventoryItems.Remove(item);
                await Db.SaveChangesAsync();
                await LoadInventory();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting: {ex.Message}");
        }
    }
}