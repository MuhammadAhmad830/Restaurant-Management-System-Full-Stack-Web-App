@page "/login"
@using Microsoft.EntityFrameworkCore
@using ResturantManagmentSystemApp.Model
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav
@inject IJSRuntime JS
@layout ResturantManagmentSystemApp.Components.Layout.EmptyLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<div class="login-page">
    <div class="login-wrapper shadow-lg animate-fade-in">

        <div class="visual-section">
            <div class="overlay"></div>
            <div class="banner-container">
                <img src="bootstrap/images/pizza-palace-banner.jpeg" class="food-img" alt="Pizza Palace Banner" />
            </div>

            <div class="brand-info">
                <div class="brand-logo-circle mb-3">
                    <i class="bi bi-shop text-white"></i>
                </div>
                <h2 class="fw-bold text-white">PIZZA PALACE</h2>
                <p class="text-white-50 small m-0">Maqbool Pur Road, Adda 83 Pulli</p>
                <div class="location-badge mt-3">
                    <i class="bi bi-geo-alt-fill me-1"></i>
                    <span>Dine-in &amp; Takeaway</span>
                </div>
                <div class="contact-info mt-2 d-block">
                    <i class="bi bi-telephone-fill me-1"></i>
                    <span>0300-7698960 | 0339-7949881</span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <div class="form-content">
                <h2 class="mb-1 fw-bold text-dark">Welcome Back</h2>
                <p class="text-muted small mb-5">PIZZA PALACE ADMINISTRATION TERMINAL</p>

                <div class="input-group-custom mb-4">
                    <label>Username</label>
                    <div class="input-wrapper">
                        <i class="bi bi-person"></i>
                        <input @bind="uName" type="text" placeholder="muhammadahmad" />
                    </div>
                </div>

                <div class="input-group-custom mb-3">
                    <label>Password</label>
                    <div class="input-wrapper">
                        <i class="bi bi-lock"></i>
                        <input @bind="uPass" type="password" placeholder="••••••••" />
                    </div>
                </div>

                <div class="text-end mb-4">
                    <a href="javascript:void(0)" class="text-primary small text-decoration-none fw-semibold">Forgot Password?</a>
                </div>

                @if (!string.IsNullOrEmpty(error))
                {
                    <div class="alert alert-danger py-2 small animate-shake d-flex align-items-center">
                        <i class="bi bi-exclamation-circle me-2"></i> @error
                    </div>
                }

                <button class="btn-login-modern w-100" @onclick="CheckLogin">
                    <span>SIGN IN</span>
                    <i class="bi bi-arrow-right-short ms-2"></i>
                </button>

                <div class="footer-note mt-4 text-center text-muted small">
                    &copy; 2026 Pizza Palace Admin Portal | All Rights Reserved
                    <br />
                    <span class="powered-by">
                        Software Powered By:
                        <strong style="color:#0056b3">Muhammad Ahmad</strong>
                        — UET Lahore
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --pp-blue: #0056b3;
        --pp-dark-blue: #004085;
        --pp-light-blue: #f0f4f8;
    }

    .login-page {
        background: #f4f6f9;
        height: 100vh;
        width: 100vw;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Segoe UI', sans-serif;
        overflow: hidden;
    }

    .login-wrapper {
        display: flex;
        width: 1000px;
        height: 600px;
        background: white;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(0,0,0,0.08);
    }

    .visual-section {
        flex: 1.1;
        background: #091a30; /* Matte premium dark background */
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 40px 36px;
        overflow: hidden;
    }

    /* Fixed: No white gloss shade overlay, pure rich backdrop */
    .overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(9, 26, 48, 0.2) 0%, rgba(9, 26, 48, 0.75) 100%);
        z-index: 2;
    }

    /* Fixed: Mathematically positions the container inside the vertical center */
    .banner-container {
        position: absolute;
        top: 50%;
        left: 0;
        transform: translateY(-60%); /* Shifts up slightly to balance layout text perfectly */
        width: 100%;
        z-index: 1;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    /* Fixed: High Definition crisp scaling configuration */
    .food-img {
        width: 100%;
        height: auto;
        object-fit: contain;
        image-rendering: -webkit-optimize-contrast;
        image-rendering: crisp-edges;
        filter: drop-shadow(0px 10px 20px rgba(0,0,0,0.3)) brightness(0.95) saturate(1.05);
    }

    .brand-info {
        position: relative;
        z-index: 5;
        margin-top: auto; /* Pushes the restaurant textual info smoothly to the bottom */
    }

    .brand-logo-circle {
        width: 50px;
        height: 50px;
        background: rgba(255,255,255,0.15);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
    }

    .brand-info h2 {
        font-size: 1.7rem;
        letter-spacing: 1.5px;
        text-shadow: 0 2px 10px rgba(0,0,0,0.7);
        margin-bottom: 4px;
    }

    .location-badge, .contact-info {
        display: inline-flex;
        align-items: center;
        font-size: 0.78rem;
        color: rgba(255,255,255,0.9);
        text-shadow: 0 1px 4px rgba(0,0,0,0.6);
    }

    /* Fixed: Solid flat separation without any clip-path shadow/white line bugs */
    .form-section {
        flex: 1.2;
        background: white;
        position: relative;
        padding: 80px;
        display: flex;
        align-items: center;
        border-left: 1px solid #eef2f5;
    }

    .form-content {
        width: 100%;
        max-width: 400px;
        margin: 0 auto;
    }

    .input-group-custom label {
        display: block;
        font-size: 0.85rem;
        font-weight: 600;
        color: #4b5563;
        margin-bottom: 8px;
    }

    .input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

        .input-wrapper i {
            position: absolute;
            left: 15px;
            color: #9ca3af;
        }

    .input-group-custom input {
        width: 100%;
        padding: 14px 14px 14px 45px;
        background: #f9fafb;
        border: 1.5px solid #e5e7eb;
        border-radius: 12px;
        outline: none;
        transition: 0.3s;
        font-size: 0.95rem;
    }

        .input-group-custom input:focus {
            background: #fff;
            border-color: var(--pp-blue);
            box-shadow: 0 0 0 4px rgba(0, 86, 179, 0.1);
        }

    .btn-login-modern {
        background: var(--pp-blue);
        color: white;
        border: none;
        padding: 16px;
        border-radius: 12px;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }

        .btn-login-modern:hover {
            background: var(--pp-dark-blue);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 86, 179, 0.3);
        }

    .text-primary {
        color: var(--pp-blue) !important;
    }

    .powered-by {
        font-size: 0.75rem;
        color: #aaa;
        margin-top: 4px;
        display: block;
    }

    .animate-fade-in {
        animation: fadeIn 0.8s ease-out;
    }

    .animate-shake {
        animation: shake 0.4s ease-in-out;
    }

    /* Fixed: Escaped Double @@ Blazor Razor Engine rules */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        25% {
            transform: translateX(-5px);
        }

        75% {
            transform: translateX(5px);
        }
    }

    @@media (max-width: 900px) {
        .visual-section {
            display: none;
        }

        .form-section {
            padding: 40px;
            border-left: none;
        }

        .login-wrapper {
            width: 90%;
            height: auto;
        }
    }
</style>

@code {
    private string uName = "";
    private string uPass = "";
    private string error = "";

    private async Task CheckLogin()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(uName) || string.IsNullOrWhiteSpace(uPass))
        {
            error = "Please fill in all fields.";
            return;
        }

        try
        {
            if (uName.Trim() == "muhammadahmad" && uPass.Trim() == "123")
            {
                await JS.InvokeVoidAsync("sessionStorage.setItem", "userName", "Muhammad Ahmad");
                await JS.InvokeVoidAsync("sessionStorage.setItem", "isLoggedIn", "true");
                Nav.NavigateTo("/", forceLoad: true);
                return;
            }

            using var dbContext = await DbFactory.CreateDbContextAsync();
            var user = await dbContext.Users.FirstOrDefaultAsync(x => x.Username == uName && x.Password == uPass);

            if (user != null)
            {
                await JS.InvokeVoidAsync("sessionStorage.setItem", "userName", user.FullName);
                await JS.InvokeVoidAsync("sessionStorage.setItem", "isLoggedIn", "true");
                Nav.NavigateTo("/", forceLoad: true);
            }
            else
            {
                error = "Invalid credentials. Please try again.";
            }
        }
        catch (Exception)
        {
            error = "Database Connection Error.";
        }
    }
}