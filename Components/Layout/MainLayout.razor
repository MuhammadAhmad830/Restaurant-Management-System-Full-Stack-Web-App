@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="page" style="display:flex; min-height:100vh; font-family:'Segoe UI',sans-serif;">
    @if (!Nav.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase))
    {
        <div class="sidebar" style="width:270px; background:linear-gradient(180deg, #0d6efd 0%, #0a58ca 100%); color:white; z-index:1000; display:flex; flex-direction:column;">
            <NavMenu />
        </div>

        <main style="flex:1; display:flex; flex-direction:column; background:#f0f4f8;">
            <div class="top-row px-4 d-flex align-items-center justify-content-between"
                 style="height:62px; background:white; border-bottom:1px solid #e8ecf0; box-shadow:0 1px 6px rgba(0,0,0,0.06);">

                <div style="display:flex; align-items:center; gap:10px;">
                    <i class="bi bi-shield-check" style="color:#0d6efd; font-size:1.1rem;"></i>
                    <span style="font-weight:700; color:#1a1a2e; font-size:0.95rem; letter-spacing:0.3px;">Pizza Palace Admin Portal</span>
                </div>

                <div style="display:flex; align-items:center; gap:8px; background:#f0f4f8; border-radius:20px; padding:6px 14px;">
                    <div style="width:8px; height:8px; background:#28a745; border-radius:50%;"></div>
                    <span style="font-size:0.78rem; color:#555; font-weight:500;">Connected</span>
                </div>
            </div>

            <article class="content px-4 py-4" style="flex:1; overflow-y:auto;">
                @Body
            </article>
        </main>
    }
    else
    {
        <div style="width:100%; height:100vh; background:#f0f4f8;">
            @Body
        </div>
    }
</div>

<style>
    @@media print {
        .sidebar, .top-row {
            display: none !important;
        }

        main {
            margin: 0 !important;
            padding: 0 !important;
        }

        .content {
            padding: 0 !important;
        }
    }
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!Nav.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase))
            {
                var user = await JS.InvokeAsync<string>("sessionStorage.getItem", "userName");
                if (string.IsNullOrEmpty(user))
                {
                    Nav.NavigateTo("/login", forceLoad: true);
                }
            }
        }
    }
}